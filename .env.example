# Copy to .env and fill in. NEVER commit .env (it is git-ignored and docker-ignored).
# Full reference: USER_GUIDE.md §6.1. Values below are safe DEVELOPMENT defaults.

# --- Environment & 4MOST safety ------------------------------------------------------------
# production only on the production deployment; anything else refuses writes to the production 4MOST
TIDES_ENV=development
# off | dry_run | live   (live only in production; dry_run logs payloads to tides_4most_log)
FOURMOST_MODE=off

# --- TiDES database (PostgreSQL with the q3c extension) -----------------------------------
TIDES_DB_HOST=localhost
TIDES_DB_PORT=5432
TIDES_DB_USER=db_user
TIDES_DB_PASS=db_pass
TIDES_DB_DATABASE=tides_dev
# Database the tests may TRUNCATE (must be local and contain 'test' or 'mock' in its name)
TIDES_TEST_DB_DATABASE=tides_dev_test

# --- 4MOST API ------------------------------------------------------------------------------
FOURMOST_SCHEMA=https://4most.mpe.mpg.de/QFSwi/targetCat/transients/
FOURMOST_USERNAME=your_username
FOURMOST_PASSWORD=your_password
FOURMOST_ACCESS_TOKEN=your_token
# 15 = TiDES (shared with another programme's subsurvey 'source')
FOURMOST_SURVEY_ID=15

# --- Surveys / Lasair Kafka -----------------------------------------------------------------
SURVEYS_ENABLED=lsst
LASAIR_LSST_TOPIC=lasair_16TiDES_Frohmaier_et_al_2025
# Leave EMPTY in development (a random group is used). In production set a FIXED value.
# NEVER put the production group id in a development .env: dev runs commit offsets to it.
LASAIR_LSST_GROUP_ID=
LASAIR_ZTF_TOPIC=
LASAIR_ZTF_GROUP_ID=

# Selection pipeline/version recorded for each survey (must exist in the pipelines table)
LSST_PIPELINE_NAME=TiDES-LSST-default
LSST_PIPELINE_VERSION=v1.0
ZTF_PIPELINE_NAME=TiDES-ZTF-default
ZTF_PIPELINE_VERSION=v1.0

# --- Ingest behaviour -----------------------------------------------------------------------
# Observing nights (of the survey that last detected an object) without a new detection
# before it is deactivated
DEACTIVATE_AFTER_DAYS=10
KAFKA_MAX_MESSAGES=20000

# --- Lasair API (host-galaxy flow / Sherlock only; Kafka needs no token) ---------------------
LASAIR_LSST_TOKEN=your_lasair_lsst_token
LASAIR_ZTF_TOKEN=your_lasair_ztf_token

# --- Provenance (normally set by the deployment, see prefect.yaml) --------------------------
# GIT_SHA=
