# /etc/tides/worker.env (root:docker, mode 640): read by systemd for spo_4most-worker.service,
# and sourced by deploy/deploy.sh. Never commit the real file.

# The Prefect API on this host (the server publishes 4200 on 127.0.0.1)
PREFECT_API_URL=http://127.0.0.1:4200/api
# Same "user:password" as PREFECT_AUTH_STRING in deploy/prefect-server/.env
PREFECT_API_AUTH_STRING=admin:change-me
# Flow runs send a heartbeat every 60 s; the zombie automation marks runs without one as Crashed
PREFECT_RUNNER_HEARTBEAT_FREQUENCY=60
# Keep Prefect's local state (profiles, caches) out of the user's home
PREFECT_HOME=/opt/tides/prefect-home
