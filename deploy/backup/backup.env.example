# /etc/tides/backup.env (root:root, mode 600). Never commit the real file.
BACKUP_DIR=/srv/tides/backups

# The TiDES database. Use a read-only login (member of tides_readonly, see database_setup/roles.sql);
# its password goes in /etc/tides/backup.pgpass (root:root, 600), one line:
#   <host>:5432:<database>:<user>:<password>
TIDES_DB_HOST=192.0.2.20
TIDES_DB_PORT=5432
TIDES_DB_DATABASE=spo_4most_tides
TIDES_DB_USER=tides_backup
PGPASS_FILE=/etc/tides/backup.pgpass

# Compose project of deploy/prefect-server (its db container is dumped with docker exec)
PREFECT_COMPOSE_PROJECT=tides-prefect

# Retention: daily dumps for KEEP_DAYS days; the dump of the 1st of each month for KEEP_MONTHLY_DAYS
KEEP_DAYS=14
KEEP_MONTHLY_DAYS=2000

# Slack/Mattermost incoming webhook for failures (the same channel as the Prefect alerts)
ALERT_WEBHOOK_URL=

# Optional off-site copy after a successful night, e.g.
#   OFFSITE_CMD='rclone copy /srv/tides/backups remote:tides-backups --max-age 48h'
OFFSITE_CMD=
