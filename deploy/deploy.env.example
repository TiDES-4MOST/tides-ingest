# /etc/tides/deploy.env (root:docker, mode 640): read by deploy/deploy.sh (together with worker.env).
# The production .env that every flow run gets mounted read-only (root:docker, mode 640)
TIDES_ENV_FILE=/etc/tides/spo_4most.env
# Defaults, normally left alone:
# TIDES_DOCKER_NETWORK=prefect_net
# PREFECT_INTERNAL_API_URL=http://server:4200/api
# PREFECT_BIN=/opt/tides/venv/bin/prefect
