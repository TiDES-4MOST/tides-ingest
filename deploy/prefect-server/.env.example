# Copy to .env next to docker-compose.yml, chmod 600, fill in. Never commit the real file.

# Password of the Prefect server's own database (only the server uses it). Long and random:
#   openssl rand -hex 24
PREFECT_DB_PASSWORD=change-me

# Where that database lives: a directory on the DATA VOLUME (it must exist; see deploy/README.md)
PREFECT_DB_DIR=/srv/tides/prefect-postgres

# Basic auth for the Prefect API and UI, as "user:password". The same value goes into
# PREFECT_API_AUTH_STRING of /etc/tides/worker.env. Use a new password (not the old nginx one).
PREFECT_AUTH_STRING=admin:change-me

# The URL of the API as the browser sees it (through the HTTPS proxy on the web server),
# and of the UI itself (used for the links in alert messages)
PREFECT_UI_API_URL=https://prefect.example.org/api
PREFECT_UI_URL=https://prefect.example.org

# This VM's private IP address (the nginx proxy connects to it; never a public address)
PREFECT_PRIVATE_IP=192.0.2.10
